# =============================================================================
# code-server Environment Configuration
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Edit .env with your values
# 3. NEVER commit .env to version control (it is in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# code-server version
# -----------------------------------------------------------------------------
# Pin a specific version for reproducible deployments.
# Check available releases at: https://github.com/coder/code-server/releases
# Run ./update.sh <version> to upgrade.
CODE_SERVER_VERSION=4.102.1

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# 'none'     → no login screen — use this when Pangolin SSO is in front (default)
# 'password' → enable code-server's built-in password prompt
AUTH=none

# Only needed when AUTH=password. Use a strong, unique value.
# PASSWORD=changeme_use_a_strong_password

# SHA-256 hashed password alternative (overrides PASSWORD when set).
# Generate: printf '%s' 'mypassword' | sha256sum | awk '{print $1}'
# HASHED_PASSWORD=

# -----------------------------------------------------------------------------
# Workspace & data persistence
# -----------------------------------------------------------------------------
# Base directory on the HOST where all data is stored.
# Subfolders created automatically:
#   ./data/config   → VS Code settings, extensions, keybindings
#   ./data/projects → your project files
DATA_DIR=./data

# Default folder opened in the editor on startup.
DEFAULT_WORKSPACE=/home/coder/projects

# -----------------------------------------------------------------------------
# Reverse proxy (Pangolin)
# -----------------------------------------------------------------------------
# Set to the public domain Pangolin assigns to this resource.
# This ensures code-server generates correct absolute URLs.
# Example: PROXY_DOMAIN=code.yourdomain.com
PROXY_DOMAIN=

# -----------------------------------------------------------------------------
# Timezone
# -----------------------------------------------------------------------------
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/Argentina/Buenos_Aires

# -----------------------------------------------------------------------------
# Docker socket access (optional)
# -----------------------------------------------------------------------------
# To run `docker` commands from the code-server terminal, the coder user
# needs to belong to the Docker group on the host.
#
# Find your Docker GID:  stat -c '%g' /var/run/docker.sock
# Then set it here and uncomment `group_add` in docker-compose.yml.
# DOCKER_GID=999
